#!/bin/bash
set -euo pipefail

if [[ "${SUBSCRIPTION_RUNTIME_SANDBOX_KIND:-}" != "hosted-codex-job" ]]; then
  printf '%s\n' 'subscription_runtime_global_scan_guard_wrong_scope expected=hosted-codex-job exit_code=64' >&2
  exit 64
fi

script_dir="${BASH_SOURCE[0]%/*}"
if [[ "${script_dir}" == "${BASH_SOURCE[0]}" ]]; then
  script_dir=.
fi
readonly integration_dir="$(cd -- "${script_dir}/.." && pwd -P)"
unset script_dir
readonly launcher="${integration_dir}/launch-hosted-codex-job"
readonly codex_real="${SUBSCRIPTION_RUNTIME_GLOBAL_SCAN_GUARD_CODEX_SOURCE:-}"

if [[ ! -x "${launcher}" ]]; then
  printf 'subscription_runtime_global_scan_guard_prerequisite_missing path=%s exit_code=70\n' "${launcher}" >&2
  exit 70
fi
if [[ -z "${codex_real}" || "${codex_real}" != /* || ! -x "${codex_real}" ]]; then
  printf 'subscription_runtime_global_scan_guard_codex_source_unavailable path=%s exit_code=70\n' "${codex_real:-unset}" >&2
  exit 70
fi
if [[ "${codex_real}" -ef "${BASH_SOURCE[0]}" ]]; then
  printf 'subscription_runtime_global_scan_guard_codex_source_recursive path=%s exit_code=70\n' "${codex_real}" >&2
  exit 70
fi

exec "${launcher}" "${codex_real}" "$@"
