#!/bin/bash
set -euo pipefail

if [[ "${SUBSCRIPTION_RUNTIME_SANDBOX_KIND:-}" != "hosted-codex-job" ]]; then
  printf '%s\n' 'subscription_runtime_global_scan_guard_wrong_scope expected=hosted-codex-job exit_code=64' >&2
  exit 64
fi
if (( $# == 0 )); then
  printf '%s\n' 'subscription_runtime_global_scan_guard_command_required exit_code=64' >&2
  exit 64
fi
if [[ "$1" != /* || ! -x "$1" ]]; then
  printf 'subscription_runtime_global_scan_guard_host_entrypoint_unavailable path=%s exit_code=70\n' "$1" >&2
  exit 70
fi
if [[ -z "${PATH:-}" ]]; then
  printf '%s\n' 'subscription_runtime_global_scan_guard_path_unavailable exit_code=70' >&2
  exit 70
fi

script_dir="${BASH_SOURCE[0]%/*}"
if [[ "${script_dir}" == "${BASH_SOURCE[0]}" ]]; then
  script_dir=.
fi
readonly integration_dir="$(cd -- "${script_dir}" && pwd -P)"
unset script_dir
readonly guarded_codex_dir="${integration_dir}/codex-bin"
readonly guarded_codex="${guarded_codex_dir}/codex"
readonly codex_real="${SUBSCRIPTION_RUNTIME_GLOBAL_SCAN_GUARD_CODEX_SOURCE:-}"

if [[ ! -x "${guarded_codex}" ]]; then
  printf 'subscription_runtime_global_scan_guard_prerequisite_missing path=%s exit_code=70\n' "${guarded_codex}" >&2
  exit 70
fi
if [[ -z "${codex_real}" || "${codex_real}" != /* || ! -x "${codex_real}" ]]; then
  printf 'subscription_runtime_global_scan_guard_codex_source_unavailable path=%s exit_code=70\n' "${codex_real:-unset}" >&2
  exit 70
fi
if [[ "${codex_real}" -ef "${guarded_codex}" ]]; then
  printf 'subscription_runtime_global_scan_guard_codex_source_recursive path=%s exit_code=70\n' "${codex_real}" >&2
  exit 70
fi

# The hosted subscription-runtime CLI resolves both its default `codex` value
# and an explicit `--codex-binary codex` through this job-local PATH prefix.
# Absolute caller overrides remain explicit operator configuration.
export PATH="${guarded_codex_dir}:${PATH}"
exec "${integration_dir}/../readonly-test-supervisor.mjs" runtime -- "$@"
