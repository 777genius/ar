/** Exact trusted lexical check, real disposable FDs; no HOST/root authority. */
import assert from 'node:assert/strict';import test from 'node:test';import * as fs from 'node:fs';import {tmpdir} from 'node:os';import {join} from 'node:path';import ts from 'typescript';
import {assertRegularName} from './stage-current-positive-public.mts';
type Held={fd:number;name:string;real:string;directory:boolean;dev:bigint;ino:bigint;mode:bigint;mnt:string;size:bigint;ctime:bigint;mtime:bigint;live:boolean};
if(process.env.TEST_C_FRESH_CHECK_EXACT_NODE24==='1'){assert.equal(process.platform,'linux');assert.equal(process.arch,'x64');assert.equal(process.version,'v24.21.0');}
const counts=new Map<string,number>();
function checkFor(file:string,ports:object,mount:(fd:number)=>string){const src=fs.readFileSync(new URL(file,import.meta.url),'utf8'),parsed=ts.createSourceFile(file,src,ts.ScriptTarget.Latest,true,ts.ScriptKind.TS);let expr:ts.Expression|undefined;function visit(n:ts.Node){if(ts.isVariableDeclaration(n)&&n.name.getText(parsed)==='check')expr=n.initializer;ts.forEachChild(n,visit);}visit(parsed);assert(expr);const js=ts.transpileModule('const selected='+expr.getText(parsed),{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.None}}).outputText;return new Function('fs','hold','C','mount','fdPath','assertRegularName',js+';return selected;')(ports,(v:unknown,why:string)=>assert(v,why),fs.constants,mount,(h:Held)=>h.name,assertRegularName) as (h:Held)=>void;}
function fixture(){const dir=fs.mkdtempSync(join(tmpdir(),'fresh-check-')),path=join(dir,'leaf');fs.writeFileSync(path,'public bytes');fs.chmodSync(path,0o644);const fd=fs.openSync(path,'r'),s=fs.fstatSync(fd,{bigint:true});const h:Held={fd,name:path,real:fs.realpathSync.native(path),directory:false,dev:s.dev,ino:s.ino,mode:s.mode,mnt:'1',size:s.size,ctime:s.ctimeNs,mtime:s.mtimeNs,live:true};let changedMount=false,badReopen=false;const ports={...fs,fstatSync(f:number,o?:unknown){counts.set('fstat',(counts.get('fstat')??0)+1);const s=fs.fstatSync(f,o as {bigint:true});return new Proxy(s,{get(t,k){if(k==='uid'||k==='gid')return 0n;if(badReopen&&f!==fd&&k==='dev')return t.dev+1n;const v=Reflect.get(t,k);return typeof v==='function'?v.bind(t):v;}});},lstatSync(p:string,o?:unknown){const s=fs.lstatSync(p,o as {bigint:true});return new Proxy(s,{get(t,k){if(k==='uid'||k==='gid')return 0n;const v=Reflect.get(t,k);return typeof v==='function'?v.bind(t):v;}});},openSync(...a:Parameters<typeof fs.openSync>){counts.set('open',(counts.get('open')??0)+1);return fs.openSync(...a);}};const check=checkFor('./stage-current-positive-public.mts',ports,()=>changedMount?'2':'1');return{dir,path,h,check,changeMount(){changedMount=true;},badReopen(){badReopen=true;},close(){fs.closeSync(fd);fs.rmSync(dir,{recursive:true,force:true});}};}
test('exact fused check performs one named reopen and two fresh stats for valid regular leaf',()=>{const f=fixture();try{counts.clear();f.check(f.h);assert.equal(counts.get('open'),1);assert.equal(counts.get('fstat'),2);}finally{f.close();}});
test('actual retained leaf rename/replacement and symlink substitution are refused',()=>{for(const symlink of [false,true]){const f=fixture();try{fs.renameSync(f.path,f.path+'.old');if(symlink)fs.symlinkSync(f.path+'.old',f.path);else fs.writeFileSync(f.path,'public bytes');assert.throws(()=>f.check(f.h));}finally{f.close();}}});
test('actual byte append and mode drift are refused',()=>{for(const mode of [false,true]){const f=fixture();try{if(mode)fs.chmodSync(f.path,0o600);else fs.appendFileSync(f.path,'more');assert.throws(()=>f.check(f.h));}finally{f.close();}}});
test('fresh mount and reopened device substitutions are refused',()=>{for(const key of ['changeMount','badReopen'] as const){const f=fixture();try{f[key]();assert.throws(()=>f.check(f.h));}finally{f.close();}}});
test('native and JS realpath agree for real nested/symlink and renamed/deleted paths; failures never fallback',()=>{const d=fs.mkdtempSync(join(tmpdir(),'native-path-'));try{fs.mkdirSync(join(d,'nested'));fs.writeFileSync(join(d,'nested','leaf'),'a');fs.symlinkSync('nested',join(d,'alias'));const p=join(d,'alias','leaf');assert.equal(fs.realpathSync(p),fs.realpathSync.native(p));fs.renameSync(join(d,'nested'),join(d,'moved'));for(const resolve of [fs.realpathSync,fs.realpathSync.native])assert.throws(()=>resolve(p));const moved=join(d,'moved','leaf');assert.equal(fs.realpathSync(moved),fs.realpathSync.native(moved));fs.unlinkSync(moved);for(const resolve of [fs.realpathSync,fs.realpathSync.native])assert.throws(()=>resolve(moved));}finally{fs.rmSync(d,{recursive:true,force:true});}});
test('Linux procfd native/JS endpoint agreement on live, renamed and deleted disposable FD',{skip:process.platform!=='linux'?'Linux /proc/self/fd unavailable on non-Linux host':false},(t)=>{const d=fs.mkdtempSync(join(tmpdir(),'native-procfd-')),p=join(d,'leaf');fs.writeFileSync(p,'a');const fd=fs.openSync(p,'r');try{const n='/proc/self/fd/'+fd;assert.equal(fs.realpathSync(n),fs.realpathSync.native(n));const expected=fs.realpathSync(n),rounds=1000,timings=[];for(const [kind,resolve] of [['JS',fs.realpathSync],['native',fs.realpathSync.native]] as const){const begin=performance.now();for(let i=0;i<rounds;i++)assert.equal(resolve(n),expected);timings.push({kind,rounds,elapsedMs:Math.round((performance.now()-begin)*1000)/1000});}t.diagnostic(JSON.stringify({kind:'FINITE_PROCFD_REALPATH_DATA',node:process.version,platform:process.platform,timings,wholeStageFitProven:false}));fs.renameSync(p,p+'.moved');assert.equal(fs.realpathSync(n),fs.realpathSync.native(n));fs.unlinkSync(p+'.moved');for(const resolve of [fs.realpathSync,fs.realpathSync.native])assert.throws(()=>resolve(n));}finally{fs.closeSync(fd);fs.rmSync(d,{recursive:true,force:true});}});
